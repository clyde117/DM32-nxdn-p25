+test("a channel moved into P25, NXDN or trunking gets talkgroup 1 when it has none, so its form saves", () => {
+	const table = columns("channels", empty(), t).find((c) => c.key === "mode");
+	const form = field("mode");
+	for (const set of [(r, v) => table.set(r, v), (r, v) => form.set(r, v)]) {
+		for (const mode of ["p25", "nxdn", "p25trunk"]) {
+			const r = { mode: "fm", talkgroup: 0, nacRx: 0x293, nacTx: 0x293 };
+			set(r, mode);
+			assert.equal(r.talkgroup, 1);
+		}
+		const kept = { mode: "dmr", talkgroup: 9, nacRx: 0x293, nacTx: 0x293 };
+		set(kept, "p25");
+		assert.equal(kept.talkgroup, 9);	// a talkgroup already set is kept
+		const fm = { mode: "dmr", talkgroup: 0 };
+		set(fm, "fm");
+		assert.equal(fm.talkgroup, 0);	// FM doesn't use one
+	}
+});
