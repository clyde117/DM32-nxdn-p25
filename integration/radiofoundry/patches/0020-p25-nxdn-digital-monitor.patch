+#if RADIO_SM_DV && CONFIG_DMR && CONFIG_P25 && CONFIG_P25_NATIVE && CONFIG_NXDN
+// Digital monitor on P25 and NXDN, as on DMR: a short press of MONITOR latches every NAC (RAN) and group for this
+// channel; TX keeps the channel's NAC (RAN) and group. Another press, Back (RREQ_DMR_HEAR_ALL off) or another channel
+// ends it (issue #2: a channel that hears every RAN without editing it)
+static void test_dv_monitor(void)
+{
+	setup_codeplug();
+	add(3, "P25 Ops", 155475000, RADIO_MODE_P25, false, 1);
+	chans[3].nac_rx = chans[3].nac_tx = 0x293;
+	chans[3].talkgroup = 100;
+	add(4, "NXDN Ops", 451125000, RADIO_MODE_NXDN, false, 1);
+	chans[4].nac_rx = chans[4].nac_tx = 12;
+	chans[4].talkgroup = 200;
+	start();
+	memset(&dv, 0, sizeof(dv));
+	req(RREQ_ZONE_POS, 2);
+	run(30);
+	CHECK(sm.view.ch.mode == RADIO_MODE_P25 && dv.cfg.nac_rx == 0x293 && !dv.cfg.hear_all);
+	req(RREQ_MONITOR, 1);
+	CHECK(!sm.view.dmr.hear_all_latch && !sm.view.monitor);	// on the release, not the press
+	req(RREQ_MONITOR, 0);
+	run(10);
+	CHECK(sm.view.dmr.hear_all_latch && !sm.view.monitor && sm.dv_running);
+	CHECK(dv.cfg.nac_rx == RADIO_DV_NAC_ANY && dv.cfg.hear_all);
+	CHECK(dv.cfg.nac_tx == 0x293 && dv.cfg.talkgroup == 100);	// TX as the channel says
+	CHECK(chans[3].nac_rx == 0x293 && sm.view.ch.nac_rx == 0x293);	// the channel itself is unchanged
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	run(10);
+	CHECK(!sm.view.dmr.hear_all_latch && dv.cfg.nac_rx == 0x293 && !dv.cfg.hear_all);
+
+	// Back (the UI's hear all off) ends it too; a press while transmitting changes nothing
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	run(10);
+	CHECK(sm.view.dmr.hear_all_latch);
+	req(RREQ_DMR_HEAR_ALL, 0);
+	run(10);
+	CHECK(!sm.view.dmr.hear_all_latch && dv.cfg.nac_rx == 0x293);
+	uint32_t id = own_dmr_id;
+	own_dmr_id = 4001;
+	dv_ptt();
+	CHECK(sm.view.state == RS_TX);
+	int selects = dv.selects;
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	CHECK(!sm.view.dmr.hear_all_latch && dv.selects == selects);
+	req(RREQ_PTT, 0);
+	dv_tx_ended(NT_TX_COMPLETE_);
+	run(20);
+	CHECK(sm.view.state == RS_IDLE);
+
+	// It lasts as long as its channel; on NXDN it hears every RAN (RX RAN 0), TX keeps RAN 12
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	run(10);
+	CHECK(sm.view.dmr.hear_all_latch);
+	req(RREQ_ZONE_POS, 3);
+	run(30);
+	CHECK(sm.view.ch.mode == RADIO_MODE_NXDN && !sm.view.dmr.hear_all_latch);
+	CHECK(dv.cfg.nac_rx == 12 && !dv.cfg.hear_all);
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);
+	run(10);
+	CHECK(sm.view.dmr.hear_all_latch && dv.cfg.nac_rx == 0 && dv.cfg.hear_all);
+	CHECK(dv.cfg.nac_tx == 12 && dv.cfg.talkgroup == 200);
+	req(RREQ_ZONE_POS, 2);
+	run(30);
+	CHECK(!sm.view.dmr.hear_all_latch && dv.cfg.nac_rx == 0x293);
+	own_dmr_id = id;
+}
+#endif
+
 int main(void)
 {
 #if RADIO_SM_DV && CONFIG_P25 && CONFIG_P25_NATIVE
 	test_p25_channel();
+#endif
+#if RADIO_SM_DV && CONFIG_DMR && CONFIG_P25 && CONFIG_P25_NATIVE && CONFIG_NXDN
+	test_dv_monitor();
 #endif
 #if RADIO_SM_DV && CONFIG_NXDN
 	test_nxdn_channel();
