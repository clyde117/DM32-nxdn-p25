+test("RX any on one channel: every RAN (RX RAN 0) on NXDN, every NAC (F7E, or F7F) on P25; TX keeps its own", () => {
+	const table = columns("channels", empty(), t);
+	const form = channelForm(empty(), t);
+	const cell = (key) => (r, k, v) => table.find((c) => c.key === key).set(r, v);
+	const parsers = [cell("nacRx"),
+		...form.filter((f) => f.key === "nacRx").map((f) => f.parse)];
+	for (const parse of parsers) {
+		const nx = { mode: "nxdn", nacRx: 5, nacTx: 5 };
+		for (const v of ["0", "any", " ANY "]) {
+			nx.nacRx = 5;
+			assert.equal(parse(nx, "nacRx", v), undefined, v);
+			assert.deepEqual([nx.nacRx, nx.nacTx], [0, 5], v);
+		}
+		assert.equal(parse(nx, "nacRx", "64"), "editor.err.range");
+		const p = { mode: "p25", nacRx: 0x293, nacTx: 0x293 };
+		for (const v of ["any", "F7E", "f7f"]) {
+			p.nacRx = 0x293;
+			assert.equal(parse(p, "nacRx", v), undefined, v);
+			assert.deepEqual([p.nacRx, p.nacTx], [0xF7E, 0x293], v);
+		}
+	}
+	// TX: neither takes any
+	const tx = { mode: "nxdn", nacRx: 0, nacTx: 5 };
+	assert.equal(cell("nacTx")(tx, "nacTx", "any"), "editor.err.range");
+});
+
